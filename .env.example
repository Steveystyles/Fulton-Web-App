# Fulton Web App production environment template.
# Copy this to /srv/storage/appdata/fultons-quiz/app.env on the server.
# Keep real values out of Git.

FULTONS_HOST=0.0.0.0
FULTONS_PORT=3000
FULTONS_TIMEZONE=Europe/London

# Keep disabled in production. Set to 1 only for throwaway local development databases.
FULTONS_SEED_DEMO_USERS=0

# Set to 1 when served over HTTPS behind Traefik.
FULTONS_COOKIE_SECURE=1

# Comma-separated allowed browser origins. Leave empty for same-origin only.
FULTONS_ALLOWED_ORIGINS=https://fultons-quiz.co.uk,https://www.fultons-quiz.co.uk

# Passwords set through the app must meet this minimum.
FULTONS_MIN_PASSWORD_LENGTH=12

# Login throttling.
FULTONS_LOGIN_MAX_ATTEMPTS=5
FULTONS_LOGIN_WINDOW_SECONDS=300
FULTONS_LOGIN_BACKOFF_SECONDS=60

# Set both only for first-run bootstrap on an empty database, then remove them.
FULTONS_BOOTSTRAP_ADMIN_USERNAME=
FULTONS_BOOTSTRAP_ADMIN_PASSWORD=

# Generate with: openssl rand -base64 32
FULTONS_NEWS_MONITOR_KEY=
FULTONS_NEWS_MONITOR_ENABLED=1
FULTONS_NEWS_MONITOR_INTERVAL_SEC=3600
FULTONS_NEWS_USER_AGENT=FultonsQuiz/0.1 (+https://fultons-quiz.co.uk)
FULTONS_WORD_DEFINITION_TIMEOUT_SEC=5

UPSTREAM_USER_AGENT=FultonHistory/1.0 (+https://fultons-quiz.co.uk)
HISTORY_CACHE_TTL_SEC=86400

# Runtime storage guards. Production should normally keep these enabled after the
# first real database exists so an empty/mis-mounted DB fails startup loudly.
FULTONS_EXPECT_DATA_DIR=/app/data
FULTONS_REQUIRE_EXISTING_DB=1
FULTONS_MIN_DB_USERS=1
FULTONS_DAILY_QUIZ_SCHEDULER_ENABLED=1
FULTONS_DAILY_QUIZ_SCHEDULER_HOUR=0
FULTONS_DAILY_QUIZ_SCHEDULER_MINUTE=5
FULTONS_DAILY_QUIZ_TRANSIENT_RETRY_INTERVAL_SEC=3600
FULTONS_DAILY_MAP_GAME_SCHEDULER_ENABLED=1
FULTONS_DAILY_MAP_GAME_SCHEDULER_HOUR=0
FULTONS_DAILY_MAP_GAME_SCHEDULER_MINUTE=2
FULTONS_DAILY_MAP_GAME_RETRY_INTERVAL_SEC=300

# Optional production map tile override. Vite exposes only VITE_* values to the
# frontend build, so set these before running npm run build if replacing OSM.
VITE_FULTONS_MAP_TILE_URL=
VITE_FULTONS_MAP_TILE_URL_NO_LABELS=
VITE_FULTONS_MAP_TILE_ATTRIBUTION=

# Daily quiz generation. Keep the quiz navigation hidden until generated content
# has been reviewed. Generate a long random INTERNAL_QUIZ_TOKEN before deployment.
AI_PROVIDER=gemini
AI_GENERATOR_MODEL=gemini-3.5-flash
AI_CRITIC_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_BASE_URL=
AI_API_KEY=
# Local training tools only. Set before running tools/openai_quiz_finetune.py --create-job.
OPENAI_FT_BASE_MODEL=
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_GENERATOR_MODEL=gemini-2.5-flash
AI_FALLBACK_CRITIC_MODEL=gemini-2.5-flash-lite
AI_FALLBACK_GEMINI_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK2_PROVIDER=gemini
AI_FALLBACK2_GENERATOR_MODEL=gemini-2.0-flash
AI_FALLBACK2_CRITIC_MODEL=gemini-2.0-flash-lite
AI_FALLBACK2_GEMINI_API_KEY=
AI_FALLBACK2_BASE_URL=
AI_FALLBACK2_API_KEY=
AI_TIMEOUT_SEC=90
AI_REQUEST_DELAY_SEC=12
AI_TRANSIENT_RETRIES=3
MAX_ATTEMPTS_PER_SLOT=15
QUESTION_HISTORY_DAYS=90
QUIZ_LEARNING_PROFILE_PATH=
INTERNAL_QUIZ_TOKEN=

# Interesting facts use the same Gemini key by default and keep a 24-hour
# rotation per place. These optional overrides are useful on the free tier to
# keep timeouts shorter than the quiz generator.
FULTONS_FACT_ROTATION_TTL_SEC=86400
FULTONS_FACTS_GEMINI_API_KEY=
FULTONS_FACTS_AI_GENERATOR_MODEL=gemini-3.5-flash
FULTONS_FACTS_AI_CRITIC_MODEL=gemini-3.1-flash-lite
FULTONS_FACTS_AI_TIMEOUT_SEC=8
FULTONS_FACTS_AI_REQUEST_DELAY_SEC=0.5
FULTONS_FACTS_AI_TRANSIENT_RETRIES=0
FULTONS_FACTS_AI_GENERATOR_BUDGET_SEC=12
FULTONS_FACTS_AI_CRITIC_BUDGET_SEC=6
FULTONS_FACT_PREWARM_ENABLED=1
FULTONS_FACT_PREWARM_LEAD_SEC=7200
FULTONS_FACT_PREWARM_POLL_SEC=60
FULTONS_FACT_PREWARM_MAX_ATTEMPTS=2
FULTONS_FACT_PREWARM_TIMEOUT_SEC=12
FULTONS_FACT_PREWARM_TRANSIENT_RETRIES=1
FULTONS_FACT_PREWARM_GENERATOR_BUDGET_SEC=24
FULTONS_FACT_PREWARM_CRITIC_BUDGET_SEC=12
FULTONS_FACT_PREWARM_WEB_SEARCH_TIMEOUT_SEC=10
FULTONS_FACTS_FALLBACK_PROVIDER=
FULTONS_FACTS_FALLBACK_GENERATOR_MODEL=
FULTONS_FACTS_FALLBACK_CRITIC_MODEL=
FULTONS_FACTS_FALLBACK_BASE_URL=
FULTONS_FACTS_FALLBACK_API_KEY=
FULTONS_FACTS_FALLBACK2_PROVIDER=
FULTONS_FACTS_FALLBACK2_GENERATOR_MODEL=
FULTONS_FACTS_FALLBACK2_CRITIC_MODEL=
FULTONS_FACTS_FALLBACK2_BASE_URL=
FULTONS_FACTS_FALLBACK2_API_KEY=

# Optional OpenAI key used only by production_server.py fact-image matching helpers.
FULTONS_OPENAI_API_KEY=
FULTONS_OPENAI_MODEL=gpt-4.1-mini
FULTONS_OPENAI_TIMEOUT_SEC=30
