# Fulton Web App production environment template
# Copy this to /srv/storage/appdata/fultons-quiz/app.env on the server.

FULTONS_HOST=0.0.0.0
FULTONS_PORT=3000
FULTONS_TIMEZONE=Europe/London

# Keep disabled in production. Set to 1 only for throwaway local development databases.
FULTONS_SEED_DEMO_USERS=0

# Set to 1 when served over HTTPS behind Traefik.
FULTONS_COOKIE_SECURE=1

# Comma-separated allowed browser origins. Leave empty for same-origin only.
FULTONS_ALLOWED_ORIGINS=https://fultons-quiz.co.uk,https://www.fultons-quiz.co.uk

# Generate with: openssl rand -base64 32
FULTONS_NEWS_MONITOR_KEY=
FULTONS_NEWS_MONITOR_ENABLED=1
FULTONS_NEWS_MONITOR_INTERVAL_SEC=900
FULTONS_NEWS_USER_AGENT=FultonsQuiz/0.1 (+https://fultons-quiz.co.uk)

UPSTREAM_USER_AGENT=FultonHistory/1.0 (+https://fultons-quiz.co.uk)
HISTORY_CACHE_TTL_SEC=86400
