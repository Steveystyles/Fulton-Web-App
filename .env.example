# Fulton Web App environment template.
# Copy this to a private file outside the Git checkout and inject it into the
# process or container. The Python entry points do not auto-load dotenv files.
# Keep real credentials, tokens, usernames, and host paths out of Git.

# Listener and public-origin policy.
FULTONS_HOST=0.0.0.0
FULTONS_PORT=3000
FULTONS_TIMEZONE=Europe/London
FULTONS_ALLOWED_ORIGINS=https://fultons-quiz.co.uk,https://www.fultons-quiz.co.uk
FULTONS_ALLOWED_HOSTS=fultons-quiz.co.uk,www.fultons-quiz.co.uk

# Proxy headers are unsafe unless every direct peer is an operator-controlled
# reverse proxy. The production Compose file enables this for its documented
# proxy-network CIDR; verify that CIDR against the target host before rollout.
FULTONS_TRUST_PROXY_HEADERS=0
FULTONS_TRUSTED_PROXY_CIDRS=

# Authentication and session policy.
FULTONS_COOKIE_SECURE=1
FULTONS_MIN_PASSWORD_LENGTH=12
FULTONS_PASSWORD_ITERATIONS=260000
FULTONS_SESSION_DAYS=14
FULTONS_SESSION_MAX_PER_USER=10
FULTONS_SESSION_ROW_LIMIT=50000
FULTONS_LOGIN_MAX_FAILURES=5
FULTONS_LOGIN_WINDOW_SECONDS=300
FULTONS_LOGIN_LOCKOUT_SECONDS=300
FULTONS_LOGIN_ATTEMPT_BUCKET_LIMIT=4096
FULTONS_LOGIN_MAX_CONCURRENT_VERIFICATIONS=4

# Keep disabled in production. Set to 1 only for disposable local databases.
FULTONS_SEED_DEMO_USERS=0

# Set both only for first-run bootstrap on an empty database, then remove them.
FULTONS_BOOTSTRAP_ADMIN_USERNAME=
FULTONS_BOOTSTRAP_ADMIN_PASSWORD=

# Request, worker, health, and durable-audit bounds.
FULTONS_HTTP_READ_TIMEOUT_SECONDS=15
FULTONS_HTTP_MAX_WORKERS=64
FULTONS_HTTP_REQUEST_MAX_BYTES=1000000
FULTONS_HEALTH_DETAIL=0
FULTONS_HEALTH_CACHE_SECONDS=15
FULTONS_AUDIT_RETENTION_DAYS=365
FULTONS_AUDIT_ROW_LIMIT=100000

# Runtime storage guards. After a real database exists, production should keep
# these enabled so an empty or mis-mounted data directory fails startup loudly.
FULTONS_EXPECT_DATA_DIR=/app/data
FULTONS_REQUIRE_EXISTING_DB=1
FULTONS_MIN_DB_USERS=1

# News monitoring, retention, and stream fan-out.
# Generate the monitor key with: openssl rand -base64 32
FULTONS_NEWS_USER_AGENT=FultonsQuiz/0.1 (+https://fultons-quiz.co.uk)
FULTONS_NEWS_RETENTION_DAYS=90
FULTONS_NEWS_ROW_LIMIT=5000
FULTONS_NEWS_STREAM_LIMIT=24
FULTONS_WORD_DEFINITION_TIMEOUT_SEC=5
FULTONS_WORD_DEFINITION_CACHE_MAX_ENTRIES=512

# Daily quiz scheduler.
FULTONS_DAILY_QUIZ_SCHEDULER_ENABLED=1
FULTONS_DAILY_QUIZ_SCHEDULER_HOUR=0
FULTONS_DAILY_QUIZ_SCHEDULER_MINUTE=5
FULTONS_DAILY_QUIZ_RETRY_INTERVAL_SEC=900
FULTONS_DAILY_QUIZ_TRANSIENT_RETRY_INTERVAL_SEC=3600
FULTONS_DAILY_QUIZ_RECOVERY_HOUR=20
QUIZ_DIAGNOSTIC_RETENTION_DAYS=14
QUIZ_DIAGNOSTIC_MAX_ROWS=5000
FULTONS_DAILY_QUIZ_RESERVE_DAYS=5
# Keep a date-independent stock of complete, evidence-verified six-question sets.
# The worker fills continuously to the target, pauses at its own or provider cap, and resumes.
FULTONS_DAILY_QUIZ_POOL_ENABLED=1
FULTONS_DAILY_QUIZ_POOL_TARGET_BATCHES=7
FULTONS_DAILY_QUIZ_POOL_MAX_BATCH_ATTEMPTS=7
FULTONS_DAILY_QUIZ_POOL_RETRY_INTERVAL_SEC=900
FULTONS_WEEKLY_SUMMARY_NTFY_URL=

# Daily map scheduler and server-side selection lifetime.
FULTONS_DAILY_MAP_GAME_SCHEDULER_ENABLED=1
FULTONS_DAILY_MAP_FUTURE_REVIEW_ENABLED=0
FULTONS_DAILY_MAP_GAME_SCHEDULER_HOUR=0
FULTONS_DAILY_MAP_GAME_SCHEDULER_MINUTE=2
FULTONS_DAILY_MAP_PREPARE_DAYS_AHEAD=2
FULTONS_DAILY_MAP_GAME_RETRY_INTERVAL_SEC=300
FULTONS_DAILY_MAP_TRANSIENT_RETRY_INTERVAL_SEC=3600
FULTONS_MAP_SELECTION_TTL_HOURS=48
FULTONS_DAILY_MAP_AI_GENERATION_ENABLED=1
FULTONS_DAILY_MAP_AI_SHORTLIST_LIMIT=24
FULTONS_DAILY_MAP_AI_MAX_CLUE_ATTEMPTS=7
FULTONS_DAILY_MAP_AI_DISCOVER_COUNT=4
FULTONS_DAILY_MAP_AI_DISCOVERY_ATTEMPTS=2
FULTONS_DAILY_MAP_AI_GENERATION_ROUNDS=3
FULTONS_DAILY_MAP_PLACE_TYPE_COOLDOWN_DAYS=3

# Set this to the public map-game launch date when using the optional launch
# sequence. Stadium rounds still pass the standard evidence and clue gates.
FULTONS_DAILY_MAP_STADIUM_LAUNCH_DATE=
FULTONS_DAILY_MAP_STADIUM_LAUNCH_ROUNDS=3

# Reverse geocoding is bounded, cached, and rate/concurrency limited. Keep the
# public provider defaults unless a reviewed equivalent is deliberately used.
FULTONS_REVERSE_GEOCODE_ENABLED=1
FULTONS_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
FULTONS_FORWARD_GEOCODE_URL=https://nominatim.openstreetmap.org/search
FULTONS_REVERSE_GEOCODE_USER_AGENT=FultonsQuiz/0.1 (+https://fultons-quiz.co.uk)
FULTONS_REVERSE_GEOCODE_LANGUAGE=en
FULTONS_REVERSE_GEOCODE_TIMEOUT_SEC=3
FULTONS_REVERSE_GEOCODE_MIN_INTERVAL_SEC=1.1
FULTONS_REVERSE_GEOCODE_MAX_RESPONSE_BYTES=1000000
FULTONS_REVERSE_GEOCODE_CACHE_TTL_DAYS=30
FULTONS_REVERSE_GEOCODE_CACHE_ROW_LIMIT=5000
FULTONS_REVERSE_GEOCODE_MAX_CONCURRENT=2

# Optional production map tile overrides. Vite exposes only VITE_* values, so
# set these before npm run build when replacing the defaults.
VITE_FULTONS_MAP_TILE_URL=
VITE_FULTONS_MAP_TILE_URL_CLEAR_BASE=
VITE_FULTONS_MAP_TILE_URL_NO_LABELS=
VITE_FULTONS_MAP_TILE_ATTRIBUTION=

# Daily quiz generation. The player-facing quiz receives opaque choice IDs;
# answers remain server-side until an immutable submission is graded.
AI_PROVIDER=gemini
AI_GENERATOR_MODEL=gemini-3.5-flash
AI_CRITIC_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_BASE_URL=
AI_API_KEY=

# Map clue generation can use an independently provisioned provider key.
MAP_CLUE_GEMINI_API_KEY=
MAP_CLUE_GENERATOR_MODEL=gemini-3.1-flash-lite
MAP_CLUE_CRITIC_MODEL=gemini-3.1-flash-lite
# Development only: use a separate Google AI project with independent quota.
# The preview tool refuses production keys and has no provider fallback.
GEMINI_API_KEY_DEV=
MAP_PREVIEW_GENERATOR_MODEL=gemini-3.1-flash-lite
MAP_PREVIEW_CRITIC_MODEL=gemini-3.1-flash-lite
MAP_CLUE_MAX_ATTEMPTS=6
MAP_CLUE_REQUIRE_AI_CRITIC=1

# Optional provider fallbacks. Keep unused credentials blank.
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_GENERATOR_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_CRITIC_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_GEMINI_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK2_PROVIDER=openrouter
AI_FALLBACK2_GENERATOR_MODEL=openrouter/free
AI_FALLBACK2_CRITIC_MODEL=openrouter/free
AI_FALLBACK2_GEMINI_API_KEY=
AI_FALLBACK2_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK2_API_KEY=
# Refuse named paid OpenRouter models. Gemini/Groq free-tier limits are enforced upstream.
QUIZ_FREE_ROUTES_ONLY=1

AI_TIMEOUT_SEC=90
AI_REQUEST_DELAY_SEC=12
AI_TRANSIENT_RETRIES=3
MAX_ATTEMPTS_PER_SLOT=15
# Persistent across scheduler restarts; forced operator regeneration bypasses it.
QUIZ_MAX_FAILED_ATTEMPTS_PER_DATE=180
QUESTION_HISTORY_DAYS=90
QUIZ_CANDIDATE_PIPELINE_ENABLED=0
QUIZ_ANSWER_EMBARGO_DAYS=45
QUIZ_RECOVERY_ANSWER_EMBARGO_DAYS=30
QUIZ_QUESTION_SIMILARITY_DAYS=180
QUIZ_CANDIDATE_BATCH_SIZE=8
QUIZ_CANDIDATE_BATCHES_PER_SLOT=3
QUIZ_CANDIDATE_MAX_CALLS_PER_QUIZ=30

# Shadow evaluation must use separate credentials so it cannot exhaust the live quota.
QUIZ_SHADOW_GEMINI_API_KEY=
QUIZ_SHADOW_AI_API_KEY=
QUIZ_SHADOW_FALLBACK_API_KEY=
QUIZ_SHADOW_FALLBACK_GEMINI_API_KEY=
QUIZ_SHADOW_FALLBACK2_API_KEY=
QUIZ_SHADOW_FALLBACK2_GEMINI_API_KEY=
QUIZ_SHADOW_EVIDENCE_OPENROUTER_API_KEY=
QUIZ_EVIDENCE_REQUIRED=1
QUIZ_EVIDENCE_SEARCH_TIMEOUT_SEC=90
QUIZ_EVIDENCE_MAX_RESULTS=8
QUIZ_EVIDENCE_OPENROUTER_API_KEY=
QUIZ_EVIDENCE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QUIZ_EVIDENCE_OPENROUTER_MODEL=openrouter/free
QUIZ_LEARNING_PROFILE_PATH=
INTERNAL_QUIZ_TOKEN=

# Local training tools only. Set before explicitly creating a fine-tuning job.
OPENAI_FT_BASE_MODEL=
## Controlled map generation (enable only after reviewing the catalogue and release).
FULTONS_DAILY_MAP_CONTROLLED_ENABLED=0
# Automatic discovery, verification and ready-round replenishment (server-side key only).
FULTONS_DAILY_MAP_AUTOMATIC_ENABLED=0
MAP_AI_API_KEY=
MAP_AI_MODEL=gemini-3.5-flash-lite
# Keep legacy live until an unpublished story-first run passes editorial and map checks.
MAP_DISCOVERY_PIPELINE=legacy
# Container default: /app/map-evidence-catalog.json
# MAP_AI_CATALOG_PATH=
